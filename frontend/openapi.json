    "/api/v1/audit": {
      "get": {
        "operationId": "audit-list",
        "parameters": [
          {
            "description": "Тип объекта, например client",
            "explode": false,
            "in": "query",
            "name": "entity",
            "schema": {
              "description": "Тип объекта, например client",
              "type": "string"
            }
          },
          {
            "description": "Пользователь",
            "explode": false,
            "in": "query",
            "name": "userId",
            "schema": {
              "description": "Пользователь",
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditListResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Журнал действий",
        "tags": [
          "audit"
        ]
      }
    },
